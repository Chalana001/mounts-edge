APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://mountsedgeregency.lk

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Queued mail (e.g. contact-form notifications) runs inline under "sync".
# To stop the contact form from blocking on SMTP, set this to "database"
# in your real .env AND keep a queue worker running (`php artisan queue:work`,
# e.g. via Supervisor, or `queue:work --stop-when-empty` on a cron).
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Free key from Google Cloud Console → "Maps Embed API". Without this, the
# contact page's map falls back to a static address card (no live map).
GOOGLE_MAPS_EMBED_KEY=

# Google Analytics 4. Leave empty for local development and preview sites.
GA_MEASUREMENT_ID=

# Contact — owner-verified 2026-10-02 (BUSINESS-TRUTH.md §1).
# WhatsApp 0777403940 monitored; inbox mountedgeregency@gmail.com.
# Runs in Admin → Site Settings; mail driver must allow Gmail sender.
MAIL_FROM_ADDRESS="mountedgeregency@gmail.com"
MAIL_FROM_NAME="Mounts Edge Regency"

# Phase 0 content gate. Keep false until docs/BUSINESS-TRUTH.md is signed.
# When true, room/wedding rows are included in image-sitemap.xml.
# Owner 2026-10-01: rooms reset to Standard + Deluxe per OTA truth (see seeder);
# set true ONLY after fresh migrate --seed on next run.
SEO_CONTENT_VERIFIED=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
